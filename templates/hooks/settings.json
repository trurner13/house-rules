{
  "autoMemoryEnabled": false,
  "disableSkillShellExecution": true,
  "cleanupPeriodDays": 3650,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.ps1"
            ],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
