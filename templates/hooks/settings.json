{
  "autoMemoryEnabled": false,
  "disableSkillShellExecution": true,
  "cleanupPeriodDays": 3650,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-sync",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.py"
            ],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
